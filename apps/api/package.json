{
  "name": "@msyen/api",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply english_homework --local",
    "db:migrate:remote": "wrangler d1 migrations apply english_homework --remote",
    "cf-typegen": "wrangler types",
    "db:seed": "node ../../scripts/db-bootstrap.mjs --local",
    "learner:demo": "node ./seed/demo-learner.mjs",
    "teacher:create": "node ./seed/create-teacher.mjs"
  },
  "dependencies": {
    "@msyen/shared": "workspace:*",
    "drizzle-orm": "^0.36.4",
    "hono": "^4.6.14",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261027.1",
    "drizzle-kit": "^0.28.1",
    "typescript": "~5.6.3",
    "wrangler": "^4.153.0"
  }
}
