# Credentials for `pnpm deploy:prod` (Cloudflare).
# Copy to .deploy.env (gitignored, never commit) and fill in:
#
#   cp .deploy.env.example .deploy.env
#
# Token: Cloudflare Dashboard → My Profile → API Tokens. Minimum permissions:
#   - Account · Workers Scripts : Edit
#   - Account · D1 : Edit
#   - Account · Workers R2 Storage : Edit
#   - Account · Queues : Edit
#   - Zone · DNS : Edit   (only for a custom domain, on that zone)

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Optional: URL to smoke-test after deploy (defaults to PUBLIC_BASE_URL in apps/api/wrangler.toml)
# PROD_URL=https://homework.example.com
